{
  "name": "Demo Fluss - ordini via Flink SQL Gateway",
  "nodes": [
    {
      "parameters": {},
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Avvia demo",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0nf0001-0000-4000-8000-000000000001",
              "name": "gatewayUrl",
              "value": "http://sql-gateway:8083",
              "type": "string"
            },
            {
              "id": "c0nf0002-0000-4000-8000-000000000002",
              "name": "numeroOrdini",
              "value": 10,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.gatewayUrl }}/v2/sessions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sessionName\": \"n8n-demo-fluss\",\n  \"properties\": {\n    \"table.dml-sync\": \"true\"\n  }\n}",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Apri sessione",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Genera ordini casuali e prepara gli statement SQL da eseguire in sequenza\nconst clienti = ['Rossi', 'Bianchi', 'Verdi', 'Russo', 'Ferrari'];\nconst n = $('Config').first().json.numeroOrdini;\nconst base = Math.floor(Date.now() / 1000) * 100;\nconst ts = $now.toFormat('yyyy-MM-dd HH:mm:ss');\n\nconst righe = [];\nfor (let i = 0; i < n; i++) {\n  const cliente = clienti[Math.floor(Math.random() * clienti.length)];\n  const importo = (Math.random() * 200 + 5).toFixed(2);\n  righe.push(`(${base + i}, '${cliente}', ${importo}, TIMESTAMP '${ts}')`);\n}\n\nconst streaming = {};\nconst batch = { 'execution.runtime-mode': 'batch' };\n\nreturn [\n  {\n    passo: '1 - catalog Fluss',\n    sql: \"CREATE CATALOG fluss_catalog WITH ('type' = 'fluss', 'bootstrap.servers' = 'coordinator-server:9123')\",\n    executionConfig: streaming,\n  },\n  { passo: '2 - usa catalog', sql: 'USE CATALOG fluss_catalog', executionConfig: streaming },\n  {\n    passo: '3 - tabella ordini',\n    sql: `CREATE TABLE IF NOT EXISTS ordini (\n  id_ordine BIGINT,\n  cliente   STRING,\n  importo   DECIMAL(10, 2),\n  ts        TIMESTAMP(3),\n  PRIMARY KEY (id_ordine) NOT ENFORCED\n)`,\n    executionConfig: streaming,\n  },\n  { passo: '4 - inserisci ordini', sql: `INSERT INTO ordini VALUES\\n${righe.join(',\\n')}`, executionConfig: streaming },\n  // I totali li calcola in continuo il job Flink 'totali-per-cliente' (jobs/totali-per-cliente.sql)\n  { passo: '5 - leggi totali', sql: 'SELECT * FROM totali_cliente LIMIT 100', executionConfig: batch },\n].map(json => ({ json }));"
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Prepara SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "Uno statement alla volta",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.gatewayUrl }}/v2/sessions/{{ $('Apri sessione').first().json.sessionHandle }}/statements",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: $json.sql, executionConfig: $json.executionConfig }) }}",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Esegui statement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.gatewayUrl }}/v2/sessions/{{ $('Apri sessione').first().json.sessionHandle }}/operations/{{ $json.operationHandle }}/result/0?rowFormat=JSON",
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $('Config').first().json.gatewayUrl + $response.body.nextResultUri }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.resultType === 'EOS' }}",
              "limitPagesFetched": true,
              "maxRequests": 60,
              "requestInterval": 2000
            }
          }
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Leggi risultato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Legge la tabella totali_cliente, tenuta aggiornata in streaming dal job Flink 'totali-per-cliente'\nconst pagine = $input.all().map(i => i.json);\nconst select = pagine.filter(p => (p.results?.columns || []).some(c => c.name === 'ultimo_ordine'));\nconst righe = select\n  .flatMap(p => p.results.data || [])\n  .filter(r => r.kind === 'INSERT' || r.kind === 'UPDATE_AFTER');\n\nif (!righe.length) {\n  throw new Error('Nessun totale letto: controlla che il job Flink \"totali-per-cliente\" sia in esecuzione (http://localhost:8083)');\n}\n\nreturn righe\n  .map(r => {\n    const [cliente, ordini, totale, ultimo_ordine] = r.fields;\n    return { cliente, ordini, totale: Number(totale), ultimo_ordine };\n  })\n  .sort((a, b) => b.totale - a.totale)\n  .map(json => ({ json }));"
      },
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Totali per cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        160
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $('Config').first().json.gatewayUrl }}/v2/sessions/{{ $('Apri sessione').first().json.sessionHandle }}",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Chiudi sessione",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        160
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "content": "## Demo Fluss + Flink SQL Gateway\n\nInserisce ordini casuali nella tabella Fluss `ordini` e legge `totali_cliente`, aggiornata in streaming dal job Flink `totali-per-cliente`.",
        "height": 200,
        "width": 420
      },
      "id": "a1f0c001-0000-4000-8000-000000000010",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -60
      ]
    }
  ],
